*.pt
*.pth

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Logs Weights & Biases
wandb/

# Jupyter Notebooks (checkpoints)
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
